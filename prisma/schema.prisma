generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- USER ----------------
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  batch      String
  department String
  year       Int

  isVerified Boolean @default(false)

  // Relations
  votes      Vote[]
  candidates Candidate[]
}

// ---------------- ADMIN ----------------
model Admin {
  id       Int         @id @default(autoincrement())
  username String      @unique
  password String
  role     AdminRole   @default(ADMIN)
  status   AdminStatus @default(PENDING)

  // Relations
  eventsCreated Event[]
}

// Admin enums
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------- EVENT ----------------
model Event {
  id                Int        @id @default(autoincrement())
  title             String
  description       String?

  allowedDept       String?
  allowedBatch      String?
  yearRestriction   Int?

  candidateDeadline DateTime
  votingStart       DateTime
  votingEnd         DateTime

  phase EventPhase @default(APPLICATION)

  createdAt DateTime @default(now())
  createdBy Int?

  // Relations
  candidates Candidate[]
  votes      Vote[]
  creator    Admin? @relation(fields: [createdBy], references: [id])
}

// Event lifecycle enum
enum EventPhase {
  APPLICATION
  VERIFICATION
  VOTING
  CLOSED
}

// ---------------- CANDIDATE ----------------
model Candidate {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  status    CandidateStatus @default(PENDING)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  votes Vote[]

  // Prevent duplicate applications
  @@unique([userId, eventId])
}

// Candidate approval enum
enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------- VOTE ----------------
model Vote {
  id          Int      @id @default(autoincrement())
  userId      Int
  eventId     Int
  candidateId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  // One vote per user per event
  @@unique([userId, eventId])
}

// ---------------- OTP ----------------
model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Faster lookup for OTP verification
  @@index([email])
}
