generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- USER ----------------
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  batch      String
  department String

  isVerified Boolean @default(false)

  // Relations
  votes        Vote[]
  candidates   Candidate[]
  notifications Notification[]
}

// ---------------- ADMIN ----------------
model Admin {
  id       Int         @id @default(autoincrement())
  username String      @unique
  password String
  role     AdminRole   @default(ADMIN)
  status   AdminStatus @default(PENDING)
}

// Admin enums
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------- EVENT ----------------
model Event {
  id                Int        @id @default(autoincrement())
  title             String
  description       String?

  allowedDept       String?
  allowedBatch      String?

  candidateDeadline DateTime
  votingStart       DateTime
  votingEnd         DateTime

  phase EventPhase @default(APPLICATION)

  createdAt DateTime @default(now())

  // Relations
  candidates Candidate[]
  votes      Vote[]
}

// Event lifecycle enum
enum EventPhase {
  APPLICATION
  VERIFICATION
  VOTING
  CLOSED
}

// ---------------- CANDIDATE ----------------
model Candidate {
  id        Int @id @default(autoincrement())
  userId    Int
  eventId   Int
  vision    String?
  statement String?

  status    CandidateStatus @default(PENDING)
  createdAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  votes Vote[]

  @@unique([userId, eventId])
}

// Candidate status enum ✅ ADDED
enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------- VOTE ---------------- ✅ ADDED
model Vote {
  id          Int      @id @default(autoincrement())
  userId      Int
  eventId     Int
  candidateId Int
  createdAt   DateTime @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  // One vote per user per event
  @@unique([userId, eventId])
}

// ---------------- OTP ----------------
model Otp{
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  isVerified Boolean @default(false)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------- NOTIFICATION ----------------
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
